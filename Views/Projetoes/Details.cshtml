@model ProjetoKanban.Models.Projeto
@{ ViewData["Title"] = Model.Nome; }
<header class="app-header">
  <a class="brand" asp-controller="Home" asp-action="Index"><img src="~/imagens/aissa-branco.svg" alt="Aissa" /></a>
  <div class="page-head"><span class="eyebrow">PROJETO</span><strong>@Model.Nome</strong></div>
  <div class="header-actions"><a class="header-link" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Editar</a><a class="header-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Projetos</a></div>
</header>
<main class="board-shell">
  <section class="board-toolbar">
    <div class="new-task"><i class="bi bi-plus-circle"></i><input type="text" maxlength="60" id="tarefaText" placeholder="Adicionar uma tarefa..." aria-label="Nome da nova tarefa" /><button id="add" class="btn-primary-app" onclick="addTarefa()">Adicionar</button></div>
    <button id="salvarEstadoProjeto" class="btn-secondary-app" onclick="salvarAlteracoes()"><i class="bi bi-cloud-check"></i> Salvar quadro</button>
  </section>
  <section class="board-scroll" aria-label="Quadro Kanban">
    <div id="tarefasProjeto" class="kanban-board">
      <div class="board-column" data-tone="slate"><header><span>Backlog</span><b>01</b></header><div id="backlog" class="coluna"></div></div>
      <div class="board-column" data-tone="violet"><header><span>Design</span><b>02</b></header><div id="design" class="coluna"></div></div>
      <div class="board-column" data-tone="blue"><header><span>Desenvolvimento</span><b>03</b></header><div id="desenvolvimento" class="coluna"></div></div>
      <div class="board-column" data-tone="amber"><header><span>Testes</span><b>04</b></header><div id="testes" class="coluna"></div></div>
      <div class="board-column" data-tone="cyan"><header><span>Implantação</span><b>05</b></header><div id="implantacao" class="coluna"></div></div>
      <div class="board-column" data-tone="green"><header><span>Conclusão</span><b>06</b><button class="icon-button" onclick="limparConclusao()" title="Limpar concluídas"><i class="bi bi-trash3"></i></button></header><div id="conclusao" class="coluna"></div></div>
    </div>
  </section>
</main>
<div class="modal-overlay" id="overlay"><div class="task-modal" id="modal"><div class="modal-header"><input class="nometarefaModal" aria-label="Nome da tarefa" /><button class="icon-button" onclick="fecharModal()" aria-label="Fechar">×</button></div><div class="modal-content"><label>Descrição</label><textarea class="descricaoTarefaModal" placeholder="Adicione contexto, critérios ou observações..."></textarea><label>Status</label><input class="statusTarefaModal" /><hr /><h4>Comentários</h4><p class="muted">Área preparada para evolução dos comentários.</p></div></div></div>
<script>
const projectId=@Model.Id;
const savedState=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.StateConteudo ?? ""));
document.getElementById("tarefaText").addEventListener("keydown",e=>{if(e.key==="Enter") addTarefa();});
function addTarefa(){
 const input=document.getElementById("tarefaText"), nome=input.value.trim(); if(!nome){showToast("Digite um nome para a tarefa.");return;}
 const chave=Date.now().toString(), card=document.createElement("button"); card.type="button"; card.className="tarefa"; card.draggable=true; card.id=chave; card.textContent=nome; card.onclick=()=>abrirModal(chave);
 document.getElementById("backlog").appendChild(card); input.value="";
 $.post("/Tarefas/Create",{nome:nome,codigodate:chave}).done(()=>showToast("Tarefa criada.")).fail(()=>{card.remove();showToast("Não foi possível criar a tarefa.");});
}
function salvarAlteracoes(){ $.post("/Projetoes/EditState",{conteudo:document.getElementById("tarefasProjeto").innerHTML,id:projectId}).done(()=>showToast("Quadro salvo.")).fail(()=>showToast("Não foi possível salvar o quadro.")); }
window.addEventListener("load",()=>{if(savedState){document.getElementById("tarefasProjeto").innerHTML=savedState;} initDragAndDrop();});
</script>